<Page x:Class="UserApp.Views.Pages.Music.UserPlayListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UserApp.Views.Pages.Music"
      mc:Ignorable="d"
      Title="UserPlayListPage">

    <Grid x:Name="UserPlayListPanel" Visibility="Visible" Background="#292929">
        <Border Width="450" Height="450" CornerRadius="450" Style="{StaticResource RoundedBorderStyle}" 
            Margin="50,80,0,0" Padding="0" Background="Transparent"
            VerticalAlignment="Top" HorizontalAlignment="Left">
            <Button Command="{Binding AddImageCommand}" Background="Transparent">
                <Grid>
                    <Image Source="/Resources/Music/AddCover.png"  Width="450" Height="450" Stretch="Fill" />
                    <Image Source="{Binding CurrentUserPlayList.PathPhoto}" Stretch="Uniform" 
                       VerticalAlignment="Top" HorizontalAlignment="Left"
                       Width="450" Height="450"/>
                </Grid>
            </Button>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="534,80,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Название: " Style="{StaticResource h1}" Foreground="White"/>
                    <Border Style="{StaticResource RoundedBorderStyle}" CornerRadius="30" Grid.Column="1">
                        <TextBox Style="{StaticResource SearchBox}" Background="#343434" Foreground="White" FontSize="80" BorderThickness="0"
                 Text="{Binding CurrentUserPlayList.Name, Mode=TwoWay}"/>
                    </Border>
                </Grid>

                <TextBlock Foreground="White" Text="Доступные треки:" Style="{StaticResource h1}" Margin="0,20,0,0"/>
                <ListView ItemsSource="{Binding Musics}" Margin="0,20,0,0" Background="Transparent" BorderThickness="0"
          VerticalAlignment="Bottom">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="30" Margin="20" Style="{StaticResource RoundedBorderStyle}">
                                <Button Command="{Binding DataContext.AddMusicToUserPlayListCommand, 
                    RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}" Padding="0"
                        Style="{StaticResource RoundedButtonStyle}"
                        Background="Transparent">
                                    <Grid Width="550" Height="350" Background="Black">
                                        <StackPanel>
                                            <Border Margin="10" Width="510" Height="200" 
                                    CornerRadius="15" 
                                    Style="{StaticResource RoundedBorderStyle}">
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                       Style="{StaticResource title}" 
                                       Margin="10,0,0,0"/>
                                            <TextBlock Text="{Binding Actor.Name}" Foreground="White"
                                       Style="{StaticResource discription}"
                                       Margin="10"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Foreground="White" Text="Треки в плейлисте:" Style="{StaticResource h1}" Margin="0,20,0,0"/>
                <ListView ItemsSource="{Binding MusicsInPlayList}" Margin="0,20,0,0" Background="Transparent" BorderThickness="0"
          VerticalAlignment="Bottom">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="30" Margin="20" Style="{StaticResource RoundedBorderStyle}">
                                <Button Command="{Binding DataContext.RemoveMusicFromUserPlayListCommand, 
                    RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}" Padding="0"
                        Style="{StaticResource RoundedButtonStyle}"
                        Background="Transparent">
                                    <Grid Width="550" Height="350" Background="Black">
                                        <StackPanel>
                                            <Border Margin="10" Width="510" Height="200" 
                                    CornerRadius="15" 
                                    Style="{StaticResource RoundedBorderStyle}">
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                       Style="{StaticResource title}" 
                                       Margin="10,0,0,0"/>
                                            <TextBlock Text="{Binding Actor.Name}" Foreground="White"
                                       Style="{StaticResource discription}"
                                       Margin="10"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
        

        <StackPanel Width="426" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,560,0,0">
            <Button Margin="0,10,0,0" Height="60" Style="{StaticResource RoundedButtonStyle}"
                Command="{Binding DeleteUserPlayListCommand}">
                <Button.Content>
                    <TextBlock Text="Удалить плейлист" Style="{StaticResource btnText}"/>
                </Button.Content>
            </Button>
            <Button Margin="0,10,0,0" Height="60" Style="{StaticResource RoundedButtonStyle}"
                Command="{Binding SaveUserPlayListCommand}">
                <Button.Content>
                    <TextBlock Text="Сохранить плейлист" Style="{StaticResource btnText}"/>
                </Button.Content>
            </Button>
        </StackPanel>
    </Grid>
</Page>
