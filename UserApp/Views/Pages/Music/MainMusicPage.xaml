 <Page x:Class="UserApp.Views.Pages.Music.MainMusicPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UserApp.Views.Pages.Music"
      xmlns:vm="clr-namespace:UserApp.ViewModels.MusicVM"
      mc:Ignorable="d" 
      d:DesignWidth="1920"
      Title="MainMusicPage"
      Loaded="Page_Loaded">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <Grid Background="#292929">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="1080"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="1">
                    <Image Source="/Resources/Music/shapkaMain.png"/>
                    <Button Style="{StaticResource RoundedButtonStyle}" 
                            Click="Button_Click" 
                            Margin="160,829,1388,162">
                        <TextBlock Text="Вернуться" Style="{StaticResource btnText}" Foreground="White"/>
                    </Button>
                </Grid>

                <!-- Search Panel -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Resources/Music/search.png"/>

                    <Grid Grid.Column="1" Height="90" Margin="30,0,100,0">
                        <Rectangle RadiusX="30" RadiusY="30" Fill="#F3F3F3"/>
                        <TextBox Text="{Binding SearchText}" Style="{StaticResource SearchBox}"
                                 Margin="20"
                                 Background="Transparent" BorderThickness="0" TextChanged="TextBox_TextChanged"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Grid.Column="2">
                        <TextBlock VerticalAlignment="Center" Margin="20">
                            <Hyperlink Click="OpenBooks_Click" Foreground="White">
                                Песни
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="20">
                            <Hyperlink Click="OpenAuthors_Click" Foreground="White">
                                Исполнители
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="20">
                            <Hyperlink Click="OpenGenres_Click" Foreground="White">
                                Жанры
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <!-- Actors Section -->
                    <Grid x:Name="AuthorPanel" >
                        <StackPanel Cursor="">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Исполнители" Margin="30" 
                                       Style="{StaticResource h1}" Foreground="White"/>
                                <Button Background="Black" FontSize="90" 
                                        Style="{StaticResource RoundButtonStyle}"
                                        Command="{Binding AddAnActorCommand}" 
                                        x:Name="AddActorBtn">
                                    <TextBlock Text="+" FontSize="80" Style="{StaticResource btnText}"/>
                                </Button>
                            </StackPanel>

                            <ListView ItemsSource="{Binding FilteredActors}" 
                                      HorizontalAlignment="Center" BorderThickness="0"
                                      Background="Transparent">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- UniformGrid с 3 колонками -->
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="30" Margin="0" 
                                                Style="{StaticResource RoundedBorderStyle}">
                                            <Button Command="{Binding DataContext.ChooseAnActorCommand, 
                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    Padding="0"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RoundedButtonStyle}"
                                                    Background="Transparent">
                                                <Grid Width="570" Height="470" >
                                                    <Rectangle Fill="#343434" Opacity="0.7"/>
                                                    <Image Source="{Binding ImagePath}"
                                                           Width="390" Height="470"
                                                           VerticalAlignment="Bottom" 
                                                           HorizontalAlignment="Right"/>
                                                    <StackPanel Margin="15,30,0,0">
                                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                                   Style="{StaticResource title}"/>
                                                        <TextBlock Text="{Binding InterestingFacts}" Margin="0,20,0,0" TextWrapping="Wrap" MaxWidth="240" HorizontalAlignment="Left"
                                                                   Foreground="White" Style="{StaticResource discription}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>

                    <!-- Music Section -->
                    <Grid x:Name="AudioBookPanel" 
                          Grid.Row="3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Песни" Margin="30" 
                                       Style="{StaticResource h1}" Foreground="White"/>
                                <Button Background="Black" FontSize="90" 
                                        Style="{StaticResource RoundButtonStyle}"
                                        Command="{Binding AddAMusicCommand}" 
                                        x:Name="AddMusicBtn">
                                    <TextBlock Text="+" FontSize="80" Style="{StaticResource btnText}"/>
                                </Button>
                            </StackPanel>

                            <ListView ItemsSource="{Binding FilteredMusics}" 
          HorizontalAlignment="Center" 
          BorderThickness="0"
          Background="Transparent">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- UniformGrid с 3 колонками -->
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="30" Margin="20" 
                    Style="{StaticResource RoundedBorderStyle}">
                                            <Button Command="{Binding DataContext.ChooseAMusicCommand, 
                        RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}" Padding="0"
                        Style="{StaticResource RoundedButtonStyle}"
                        Background="Transparent">
                                                <Grid Width="550" Height="350" Background="Black">
                                                    <StackPanel>
                                                        <Border Margin="10" Width="510" Height="200" 
                                    CornerRadius="15" 
                                    Style="{StaticResource RoundedBorderStyle}">
                                                            <Image Source="{Binding ImagePath}" 
                                       Stretch="UniformToFill"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                       Style="{StaticResource title}" 
                                       Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding Actor.Name}" Foreground="White"
                                       Style="{StaticResource discription}"
                                       Margin="10"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>

                    <!-- Genres Section -->
                    <Grid x:Name="GenrePanel" Grid.Row="2">
                        <StackPanel>
                            <TextBlock Text="Жанры" Margin="30" 
               Style="{StaticResource h1}" Foreground="White"/>
                            <ListView HorizontalAlignment="Center" Margin="5" Background="Transparent" BorderThickness="0">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.Items>
                                    <ListViewItem>
                                        <ListViewItem.Content>
                                            <Grid Width="400" Height="400" Margin="20,40,20,40" Background="Black">
                                                <Grid.Effect>
                                                    <DropShadowEffect BlurRadius="40"/>
                                                </Grid.Effect>

                                                <Button Click="OpenBooks_Click" Command="{Binding FilterByGenreCommand}" 
                                    CommandParameter="Рок"
                                    Style="{StaticResource RoundedButtonStyle}">
                                                    <Button.Content>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Image Source="/Resources/Music/rock.png"/>
                                                            <TextBlock Foreground="White" TextAlignment="Center" Text="Рок" Style="{StaticResource title}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                            </Grid>
                                        </ListViewItem.Content>
                                    </ListViewItem>
                                    <ListViewItem>
                                        <ListViewItem.Content>
                                            <Grid Width="400" Height="400" Margin="20,40,20,40" Background="Black">
                                                <Grid.Effect>
                                                    <DropShadowEffect BlurRadius="40"/>
                                                </Grid.Effect>
                                               
                                                <Button Click="OpenBooks_Click" Command="{Binding FilterByGenreCommand}" 
                                    CommandParameter="Народные"
                                    Style="{StaticResource RoundedButtonStyle}" Background="Transparent">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Image Source="/Resources/Music/narod.png"/>
                                                        <TextBlock Foreground="White" TextAlignment="Center" Text="Народные" Style="{StaticResource title}"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </ListViewItem.Content>
                                    </ListViewItem>
                                    <ListViewItem>
                                        <ListViewItem.Content>
                                            <Grid Width="400" Height="400" Margin="20,40,20,40" Background="Black">
                                                <Grid.Effect>
                                                    <DropShadowEffect BlurRadius="40"/>
                                                </Grid.Effect>
                                                
                                                <Button Click="OpenBooks_Click" Command="{Binding FilterByGenreCommand}" 
                                    CommandParameter="Поп"
                                    Style="{StaticResource RoundedButtonStyle}" Background="Transparent">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Image Source="/Resources/Music/pop.png"/>
                                                        <TextBlock TextAlignment="Center" Text="Поп" Foreground="White" Style="{StaticResource title}"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </ListViewItem.Content>
                                    </ListViewItem>
                                    <ListViewItem>
                                        <ListViewItem.Content>
                                            <Grid Width="400" Height="400" Margin="20,40,20,40" Background="Black">
                                                <Grid.Effect>
                                                    <DropShadowEffect BlurRadius="40"/>
                                                </Grid.Effect>

                                                <Button Click="OpenBooks_Click" Command="{Binding FilterByGenreCommand}" 
                                    CommandParameter="Классика"
                                    Style="{StaticResource RoundedButtonStyle}" Background="Transparent">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Image Source="/Resources/Music/Classic.png"/>
                                                        <TextBlock TextAlignment="Center" Text="Классика" Foreground="White" Style="{StaticResource title}"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </ListViewItem.Content>
                                    </ListViewItem>
                                    <ListViewItem>
                                        <ListViewItem.Content>
                                            <Grid Width="400" Height="400" Margin="20,40,20,40" Background="Black">
                                                <Grid.Effect>
                                                    <DropShadowEffect BlurRadius="40"/>
                                                </Grid.Effect>

                                                <Button Command="{Binding FilterByGenreCommand}" 
                                    CommandParameter=""
                                    Style="{StaticResource RoundedButtonStyle}" Background="Transparent">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock TextAlignment="Center" Text="Все жанры" Foreground="White" Style="{StaticResource title}"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </ListViewItem.Content>
                                    </ListViewItem>
                                </ListView.Items>
                            </ListView>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PlayListPanel" Grid.Row="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Плейлисты" Margin="30" 
                   Style="{StaticResource h1}" Foreground="White"/>
                                <Button Background="Black" FontSize="90" 
                    Style="{StaticResource RoundButtonStyle}"
                    Command="{Binding AddPlayListCommand}" 
                    x:Name="AddPlayBtn">
                                    <TextBlock Text="+" FontSize="80" Style="{StaticResource btnText}"/>
                                </Button>
                            </StackPanel>

                            <ListView ItemsSource="{Binding PlayLists}" 
                  HorizontalAlignment="Center"
                  Background="Transparent" BorderThickness="0">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- UniformGrid с 3 колонками -->
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="30" Margin="-10,0,0,0" 
                            Style="{StaticResource RoundedBorderStyle}">
                                            <Button Padding="0" Command="{Binding DataContext.ChoosePlayListCommand, 
                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="Transparent">
                                                <Grid Width="600" Height="300">
                                                    <Rectangle Fill="#343434" Opacity="0.7"/>
                                                    <Border Width="280" Height="280" CornerRadius="280" Style="{StaticResource RoundedBorderStyle}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill"
                                                               Width="280" Height="280" VerticalAlignment="Bottom"  HorizontalAlignment="Right"/>
                                                    </Border>
                                                    
                                                    <StackPanel Margin="330,30,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" 
                                               Style="{StaticResource title}"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="White" 
                                               Style="{StaticResource discription}"
                                               Margin="0,30,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="4" Width="1645" VerticalAlignment="Center">
                    <TextBlock FontSize="32" Foreground="#787878"
                               Text="Все права защищены. Адрес: ООО 'Память Поколений'"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>